# Copy to .env (never commit .env). All free-tier friendly defaults.
# Secrets
SECRETS_KEY=change-me-generate-with-openssl-rand-base64-32

# Database (local Postgres; matches docker-compose.yml)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=automation_studio
DB_USER=automation
DB_PASSWORD=automation

# Backend
BACKEND_PORT=8080
ENGINE_MAX_CONCURRENT_EXECUTIONS=8
WORKFLOW_MAX_DURATION_MS=900000
NODE_DEFAULT_TIMEOUT_MS=60000
HTTP_CONNECT_TIMEOUT_MS=10000
HTTP_READ_TIMEOUT_MS=30000
LLM_TIMEOUT_MS=180000
EXECUTION_RETENTION_DAYS=30
MAX_RESPONSE_BYTES=1048576
MAX_STORED_OUTPUT_BYTES=262144
MAX_REQUEST_BODY_BYTES=1048576

# LLM routing (OpenRouter free + local Ollama). Other providers skipped without keys.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b
